* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: #f7f2e9;
  color: #11263f;
  font-family: Arial, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

.contenedor {
  width: 90%;
  max-width: 1100px;
  margin: auto;
}

/* Header */

header {
  background: white;
  border-bottom: 1px solid #ddd;
  padding: 20px 0;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  color: #11263f;
  font-weight: bold;
}

nav {
  display: flex;
  gap: 20px;
}

nav a:hover {
  color: #a85640;
}

/* Hero */

.hero {
  background: #e9dfcf;
  padding: 100px 0;
}

.hero p:first-child {
  color: #a85640;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 2px;
}

h1 {
  font-size: 60px;
  margin: 15px 0;
}

h2 {
  font-size: 35px;
  margin-bottom: 30px;
}

.texto {
  max-width: 500px;
  line-height: 1.6;
  margin-bottom: 25px;
}

.boton,
button {
  background: #11263f;
  color: white;
  border: none;
  padding: 12px 20px;
  cursor: pointer;
  font-weight: bold;
}

.boton:hover,
button:hover {
  background: #a85640;
}

/* Productos */

.seccion {
  padding: 70px 0;
}

.productos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.producto {
  background: white;
  padding: 20px;
  text-align: center;
  box-shadow: 0 3px 10px #00000018;
}

.imagen {
  background: #e9dfcf;
  font-size: 80px;
  padding: 45px 10px;
  margin-bottom: 20px;
}

.producto h3 {
  margin-bottom: 10px;
}

.producto p {
  font-weight: bold;
  margin-bottom: 15px;
}

/* Newsletter */

.newsletter {
  background: #a85640;
  color: white;
  padding: 60px 0;
  text-align: center;
}

.newsletter h2 {
  margin-bottom: 10px;
}

.newsletter p {
  margin-bottom: 20px;
}

input {
  border: none;
  padding: 12px;
  width: 250px;
}

.newsletter button {
  background: #11263f;
}

/* Footer */

footer {
  background: #11263f;
  color: white;
  padding: 25px;
  text-align: center;
  font-size: 13px;
}

/* Celular */

@media (max-width: 700px) {
  nav {
    display: none;
  }

  h1 {
    font-size: 42px;
  }

  .productos {
    grid-template-columns: 1fr;
  }

  input {
    width: 100%;
    margin-bottom: 10px;
  }
}
